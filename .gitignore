* {
  box-sizing: border-box;
}

:root {
  --bg: #f7f3ee;
  --bg-strong: #efe5dc;
  --card: #fffdfb;
  --text: #1d1b1a;
  --muted: #6a625d;
  --accent: #b77b5d;
  --accent-dark: #8e5d3f;
  --border: rgba(29, 27, 26, 0.08);
  --shadow: 0 20px 60px rgba(42, 28, 20, 0.08);
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
}

a {
  text-decoration: none;
  color: inherit;
}

img {
  display: block;
  max-width: 100%;
}

.container {
  width: min(1120px, calc(100% - 2rem));
  margin: 0 auto;
}

.site-header {
  position: sticky;
  top: 0;
  z-index: 10;
  backdrop-filter: blur(10px);
  background: rgba(247, 243, 238, 0.85);
  border-bottom: 1px solid var(--border);
}

.nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 80px;
}

.brand {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(2rem, 3vw, 2.8rem);
  letter-spacing: 0.04em;
}

nav {
  display: flex;
  gap: 1.5rem;
  align-items: center;
  font-size: 0.95rem;
  color: var(--muted);
}

.hero {
  padding: 5rem 0 4rem;
}

.hero-inner {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 3rem;
  align-items: center;
}

.eyebrow {
  margin: 0;
  color: var(--accent-dark);
  text-transform: uppercase;
  letter-spacing: 0.18em;
  font-size: 0.75rem;
  font-weight: 600;
}

h1, h2, h3 {
  font-family: 'Cormorant Garamond', serif;
  margin: 0;
  line-height: 1.05;
}

h1 {
  font-size: clamp(3rem, 5vw, 5rem);
  margin-top: 0.7rem;
  font-weight: 600;
}

h2 {
  font-size: clamp(2.5rem, 4vw, 4rem);
  margin-top: 0.6rem;
  font-weight: 600;
}

.lead {
  max-width: 560px;
  margin: 1.25rem 0 0;
  color: var(--muted);
  font-size: 1.05rem;
}

.cta-group {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 2rem;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 50px;
  padding: 0.8rem 1.4rem;
  border-radius: 999px;
  font-weight: 600;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.btn:hover {
  transform: translateY(-2px);
}

.btn-primary {
  background: var(--text);
  color: white;
  box-shadow: var(--shadow);
}

.btn-secondary {
  border: 1px solid var(--border);
  background: rgba(255,255,255,0.3);
}

.hero-image img {
  border-radius: 28px;
  width: 100%;
  min-height: 580px;
  object-fit: cover;
  box-shadow: var(--shadow);
}

.portfolio,
.about,
.services {
  padding: 4.5rem 0;
}

.section-head {
  margin-bottom: 2rem;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.5rem;
}

.project-card {
  overflow: hidden;
  border-radius: 22px;
  background: var(--card);
  border: 1px solid var(--border);
  box-shadow: var(--shadow);
}

.project-card img {
  width: 100%;
  height: 420px;
  object-fit: cover;
}

.card-info {
  padding: 1.2rem 1.2rem 1.4rem;
}

.card-info h3 {
  font-size: 2rem;
}

.card-info p {
  margin: 0.3rem 0 0;
  color: var(--muted);
}

.about-grid {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 2rem;
  align-items: center;
}

.about-photo img {
  width: 100%;
  min-height: 540px;
  object-fit: cover;
  border-radius: 24px;
  box-shadow: var(--shadow);
}

.about-copy p {
  color: var(--muted);
  font-size: 1.02rem;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.5rem;
}

.service-box {
  background: rgba(255,255,255,0.32);
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: 1.7rem;
  box-shadow: var(--shadow);
}

.service-box span {
  font-size: 0.9rem;
  color: var(--accent-dark);
  font-weight: 700;
}

.service-box h3 {
  margin-top: 0.8rem;
  font-size: 2.3rem;
}

.service-box p {
  margin: 0.8rem 0 0;
  color: var(--muted);
}

.contact {
  padding: 2rem 0 5rem;
}

.contact-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
  padding: 2rem 2.4rem;
  border-radius: 26px;
  background: linear-gradient(135deg, rgba(255,255,255,0.7), rgba(238,228,218,0.8));
  border: 1px solid var(--border);
  box-shadow: var(--shadow);
}

.site-footer {
  border-top: 1px solid var(--border);
  padding: 1.2rem 0 2rem;
}

.footer-inner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  color: var(--muted);
}

.socials {
  display: flex;
  gap: 1rem;
}

@media (max-width: 900px) {
  .hero-inner,
  .about-grid,
  .gallery-grid,
  .services-grid {
    grid-template-columns: 1fr;
  }

  .hero-image img {
    min-height: 420px;
  }

  .contact-box,
  .nav,
  .footer-inner {
    flex-direction: column;
    align-items: flex-start;
  }

  nav {
    flex-wrap: wrap;
  }
}

@media (max-width: 560px) {
  .brand {
    font-size: 2.2rem;
  }

  nav {
    gap: 0.75rem;
    font-size: 0.85rem;
  }

  .hero {
    padding-top: 3rem;
  }

  .contact-box {
    padding: 1.5rem;
  }
}
